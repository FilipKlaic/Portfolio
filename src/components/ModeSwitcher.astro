---
---

<div class="mode-switcher" role="group" aria-label="Site mode">
  <button type="button" class="mode-switcher__option" data-mode-target="engineer">Engineer</button>
  <button type="button" class="mode-switcher__option" data-mode-target="photographer">Photographer</button>
  <span class="mode-switcher__thumb" aria-hidden="true"></span>
</div>

<style>
  .mode-switcher {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-raised);
  }

  .mode-switcher__option {
    position: relative;
    z-index: 1;
    appearance: none;
    border: none;
    background: transparent;
    color: var(--color-text-dim);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .mode-switcher__option[aria-pressed="true"] {
    color: var(--color-bg);
  }

  .mode-switcher__thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: var(--color-text);
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  @media (max-width: 420px) {
    .mode-switcher__option {
      font-size: 0.8rem;
      padding: 0.35rem 0.7rem;
    }
  }

  :global(html[data-mode="photographer"]) .mode-switcher__thumb {
    transform: translateX(100%);
  }
</style>

<script>
  function currentMode(): "engineer" | "photographer" {
    return document.documentElement.dataset.mode === "photographer" ? "photographer" : "engineer";
  }

  function syncButtons() {
    const mode = currentMode();
    document.querySelectorAll<HTMLButtonElement>("[data-mode-target]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.modeTarget === mode));
    });
  }

  function applyMode(next: "engineer" | "photographer") {
    document.documentElement.dataset.mode = next;
    localStorage.setItem("mode", next);
    syncButtons();
    window.scrollTo({ top: 0, behavior: "instant" });
  }

  function setMode(next: "engineer" | "photographer") {
    if (next === currentMode()) return;

    if (document.startViewTransition) {
      document.startViewTransition(() => applyMode(next));
    } else {
      applyMode(next);
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-mode-target]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.modeTarget;
      if (target === "engineer" || target === "photographer") setMode(target);
    });
  });

  syncButtons();
</script>
