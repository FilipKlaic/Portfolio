---
interface Project {
  nickname: string;
  fullName: string;
  slug: string;
  description: string;
  highlights: string[];
  stack: string[];
  href?: string;
  repoUrl?: string;
  repoPrivate?: boolean;
  status?: "live" | "private" | "ongoing";
}

const projects: Project[] = [
  {
    nickname: "wagons",
    fullName: "Fogarolli — Wagon Inventory",
    slug: "wagons",
    description:
      "Inventory tracking tool used on iPads during live catering events, built for the company I work at.",
    highlights: [
      "Real-time inventory counts across catering wagons, synced through Supabase",
      "Swedish-language UI built for on-the-ground staff working at speed during service",
      "In daily production use by my team at events",
    ],
    stack: ["TypeScript", "React", "Vite", "Supabase", "Vercel"],
    repoPrivate: true,
    status: "private",
  },
  {
    nickname: "shifts",
    fullName: "Fogarolli Schedule",
    slug: "shifts",
    description:
      "Companion shift-scheduling PWA for the same business, sharing one Supabase backend with the inventory app.",
    highlights: [
      "Installable on employees' phones as a progressive web app",
      "Admins create shifts; staff mark availability and acknowledge assignments",
      "Role-based access enforced with Supabase auth and row-level security policies",
    ],
    stack: ["TypeScript", "React", "Vite", "Supabase", "PWA"],
    repoPrivate: true,
    status: "private",
  },
  {
    nickname: "savings",
    fullName: "Savings Tracker",
    slug: "savings",
    description:
      "Cross-platform desktop app for tracking income and expenses, auto-allocating a share of income toward savings goals.",
    highlights: [
      "Rust and Tauri backend with local SQLite storage, schema applied via migrations on first launch",
      "Dashboard with a monthly breakdown donut chart and a savings-rate trend line",
      "Feature-sliced architecture so new features can be added without touching existing ones",
    ],
    stack: ["Rust", "Tauri", "TypeScript", "React", "SQLite"],
    repoUrl: "https://github.com/FilipKlaic/Savings-tracker",
    status: "ongoing",
  },
  {
    nickname: "meridian",
    fullName: "Meridian",
    slug: "meridian",
    description:
      "Desktop tool that visualizes a TypeScript project's architecture by mapping file imports and function call chains.",
    highlights: [
      "Rust backend using tree-sitter to parse imports, re-exports, requires, and TypeScript path aliases",
      "Interactive import and call graphs built with React Flow, color-coded by directory with a focus mode to isolate related code",
      "Scan results cached in SQLite so reopening a project is fast, with freshness tracked against file modification times",
    ],
    stack: ["Rust", "Tauri", "React", "TypeScript", "tree-sitter", "SQLite"],
    repoUrl: "https://github.com/FilipKlaic/Meridian",
    status: "ongoing",
  },
  {
    nickname: "atrium",
    fullName: "Atrium",
    slug: "atrium",
    description:
      "Cross-platform chat app built as a Slack/Discord alternative, with a native desktop client and a real-time backend.",
    highlights: [
      "Tauri desktop client for macOS and Windows with servers, channels, and role-based membership",
      "Real-time messaging over WebSockets with presence, typing indicators, and cursor-based pagination",
      "Fastify and PostgreSQL backend with Drizzle ORM, JWT auth using Argon2 hashing and rotating refresh tokens",
    ],
    stack: ["Rust", "Tauri", "React", "TypeScript", "Fastify", "PostgreSQL", "Drizzle"],
    repoUrl: "https://github.com/FilipKlaic/Atrium",
    status: "ongoing",
  },
  {
    nickname: "kova",
    fullName: "Kova Studio",
    slug: "kova",
    description: "Site for my own development studio, built around scroll-driven motion and a custom brand system.",
    highlights: [
      "Case studies built around scroll-driven animation sequences",
      "Custom design system and brand identity",
    ],
    stack: ["Next.js", "TypeScript", "Motion", "GSAP"],
    href: "https://kova-studio-bice.vercel.app/",
    repoUrl: "https://github.com/FilipKlaic/Kova-Studio",
    status: "live",
  },
  {
    nickname: "rice",
    fullName: "Linux Desktop Environment",
    slug: "rice",
    description:
      "A fully themed Hyprland desktop on Arch Linux, with a colour pipeline that regenerates the whole system theme from the current wallpaper.",
    highlights: [
      "Wallpaper changes trigger a Material You palette extraction that updates the bar, terminal, notifications, GTK apps, and launcher simultaneously",
      "Custom window animation curves and a hand-built GTK3 theme",
      "Shell scripting and config management across a dozen interlocking tools",
    ],
    stack: ["Linux", "Lua", "Shell", "GTK", "CSS"],
    status: "ongoing",
  },
];

const CONTACT = {
  email: "file.klaic@gmail.com",
  github: "https://github.com/FilipKlaic",
  linkedin: "https://www.linkedin.com/in/filip-klaic-6b2006308/",
};

const STACK_GROUPS = [
  { label: "Languages", items: ["TypeScript", "C#", "JavaScript", "Python", "Java", "SQL"] },
  { label: "Frontend", items: ["React", "Next.js", "Astro", "Vite", "HTML & CSS"] },
  { label: "Backend & data", items: ["ASP.NET Core", "Supabase", "PostgreSQL", "SQLite", "Rust (Tauri)"] },
  { label: "Tools & platforms", items: ["Git & GitHub", "Vercel", "Linux", "Figma"] },
];

const statusLabels: Record<string, string> = {
  live: "Live",
  private: "Private",
  ongoing: "In progress",
};
---

<section data-panel="engineer" class="dev">
  <header class="dev__topbar">
    <div class="dev__topbar-inner">
      <span class="dev__brand">Filip Klaic</span>
      <nav class="dev__nav">
        <a href="#about">About</a>
        <a href="#stack">Stack</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="dev__wash" aria-hidden="true"></div>

  <div class="dev__container">
    <section class="dev__hero">
      <p class="dev__availability">
        <span class="dev__availability-dot" aria-hidden="true"></span>
        Available for junior developer roles
      </p>
      <h1 class="dev__name">Filip Klaic</h1>
      <p class="dev__role">Junior Software Developer</p>
      <p class="dev__lead">
        I build web and desktop applications that people actually use day to day — from inventory tools running on
        iPads during live events to a cross-platform finance tracker. Currently studying Systemutvecklare .NET and
        looking for my first full-time developer role.
      </p>
      <div class="dev__actions">
        <a href="#work" class="dev__btn dev__btn--primary">View my work</a>
        <a href={`mailto:${CONTACT.email}`} class="dev__btn dev__btn--secondary">Get in touch</a>
      </div>
    </section>

    <section id="about" class="dev__section dev__reveal">
      <h2 class="dev__section-title">About</h2>
      <div class="dev__about">
        <div class="dev__about-text">
          <p>
            I got into programming at Ehrensvärdska high school through the Teknik, Info &amp; Media program, where I
            first learned C#, HTML, CSS, and JavaScript. I'm now studying at the college level as a Systemutvecklare
            .NET, and I pick up new languages and frameworks on my own time alongside it.
          </p>
          <p>
            What keeps me building is solving problems for people I actually know. The wagon inventory app started as
            something I made for myself and my coworkers to make our shifts easier, and it grew into two production
            apps the business now depends on.
          </p>
        </div>
        <dl class="dev__facts">
          <div class="dev__fact">
            <dt>Location</dt>
            <dd>Sweden</dd>
          </div>
          <div class="dev__fact">
            <dt>Education</dt>
            <dd>Systemutvecklare .NET (studying)</dd>
          </div>
          <div class="dev__fact">
            <dt>Focus</dt>
            <dd>Full-stack web &amp; desktop applications</dd>
          </div>
          <div class="dev__fact">
            <dt>Looking for</dt>
            <dd>Junior developer role</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="stack" class="dev__section dev__reveal">
      <h2 class="dev__section-title">Tech stack</h2>
      <div class="dev__stack-groups">
        {
          STACK_GROUPS.map((group) => (
            <div class="dev__stack-group">
              <h3 class="dev__stack-label">{group.label}</h3>
              <ul class="dev__stack-list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="work" class="dev__section dev__reveal">
      <h2 class="dev__section-title">Selected work</h2>
      <ul class="dev__projects">
        {
          projects.map((project) => (
            <li class="dev__project dev__reveal">
              <div class="dev__project-head">
                <h3 class="dev__project-title">{project.fullName}</h3>
                {project.status && (
                  <span class="dev__badge" data-status={project.status}>
                    {statusLabels[project.status]}
                  </span>
                )}
              </div>
              <p class="dev__project-desc">{project.description}</p>
              <ul class="dev__project-highlights">
                {project.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <ul class="dev__tags">
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <div class="dev__project-links">
                {project.href && (
                  <a href={project.href} target="_blank" rel="noopener noreferrer">
                    Visit site
                  </a>
                )}
                {project.repoUrl && (
                  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                    View code
                  </a>
                )}
                {project.repoPrivate && <span class="dev__project-note">Private repository</span>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="dev__section dev__reveal">
      <h2 class="dev__section-title">Get in touch</h2>
      <p class="dev__contact-lead">
        I'm looking for a junior developer role and happy to talk about anything I've built here. The fastest way to
        reach me is email.
      </p>
      <div class="dev__contact-links">
        <a href={`mailto:${CONTACT.email}`} class="dev__btn dev__btn--primary">{CONTACT.email}</a>
        <a href={CONTACT.github} class="dev__btn dev__btn--secondary" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a href={CONTACT.linkedin} class="dev__btn dev__btn--secondary" target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </div>
    </section>

    <footer class="dev__footer">
      <p>&copy; 2026 Filip Klaic</p>
      <p>Built with Astro</p>
    </footer>
  </div>
</section>

<script>
  const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(".dev__reveal"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (revealTargets.length > 0 && !reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -60px 0px" },
    );

    revealTargets.forEach((el) => {
      // Only arm elements that start below the fold, so nothing visible flickers on load.
      if (el.getBoundingClientRect().top < window.innerHeight * 0.9) return;
      el.classList.add("dev__reveal--armed");
      observer.observe(el);
    });
  }
</script>

<style>
  .dev {
    position: relative;
    color: var(--color-text);
  }

  .dev__wash {
    position: absolute;
    top: -8rem;
    left: -10%;
    right: -10%;
    height: 42rem;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        42% 50% at 22% 26%,
        color-mix(in srgb, var(--color-accent) 20%, transparent),
        transparent 70%
      ),
      radial-gradient(
        38% 46% at 82% 12%,
        color-mix(in srgb, var(--color-accent-2) 18%, transparent),
        transparent 70%
      );
    filter: blur(28px);
  }

  .dev__container {
    position: relative;
    z-index: 1;
  }

  /* Scroll reveal ---------------------------------------------------------- */

  .dev__reveal--armed {
    opacity: 0;
    transform: translateY(16px);
  }

  .dev__reveal--armed.is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dev__container {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 var(--space-3);
  }

  /* Top bar ------------------------------------------------------------- */

  .dev__topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .dev__topbar-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .dev__brand {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dev__nav {
    display: flex;
    gap: var(--space-3);
  }

  .dev__nav a {
    color: var(--color-text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 150ms ease;
  }

  .dev__nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 34rem) {
    .dev__nav {
      display: none;
    }
  }

  /* Hero ---------------------------------------------------------------- */

  .dev__hero {
    padding: var(--space-6) 0 var(--space-5);
  }

  .dev__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

  .dev__availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ecf8e;
  }

  .dev__name {
    margin-top: var(--space-3);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .dev__role {
    margin-top: var(--space-1);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .dev__lead {
    margin-top: var(--space-3);
    max-width: 40rem;
    font-size: 1.05rem;
    color: var(--color-text-dim);
  }

  .dev__actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dev__btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .dev__btn--primary {
    background: var(--color-accent);
    color: #08111f;
    border: 1px solid var(--color-accent);
  }

  .dev__btn--primary:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, white);
  }

  .dev__btn--secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .dev__btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Sections ------------------------------------------------------------ */

  .dev__section {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .dev__section-title {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: var(--space-3);
  }

  /* About --------------------------------------------------------------- */

  .dev__about {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .dev__about {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .dev__about-text p + p {
    margin-top: var(--space-2);
  }

  .dev__about-text p {
    color: var(--color-text-dim);
  }

  .dev__facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .dev__fact dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
  }

  .dev__fact dd {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
  }

  /* Stack --------------------------------------------------------------- */

  .dev__stack-groups {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .dev__stack-label {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .dev__stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .dev__stack-list li {
    font-size: 0.92rem;
    color: var(--color-text-dim);
  }

  /* Projects ------------------------------------------------------------ */

  .dev__projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .dev__project {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg-raised);
    padding: var(--space-3);
    transition:
      border-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease,
      background 200ms ease;
  }

  .dev__project:hover {
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-border));
    background: var(--color-bg-hover);
    transform: translateY(-3px);
    box-shadow:
      0 12px 28px -18px rgba(0, 0, 0, 0.9),
      0 0 32px -22px var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .dev__project:hover {
      transform: none;
    }
  }

  .dev__project-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dev__project-title {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .dev__badge {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  .dev__badge[data-status="live"] {
    color: #3ecf8e;
    border-color: color-mix(in srgb, #3ecf8e 45%, transparent);
  }

  .dev__project-desc {
    margin-top: var(--space-1);
    color: var(--color-text-dim);
    font-size: 0.95rem;
  }

  .dev__project-highlights {
    margin: var(--space-2) 0 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dev__project-highlights li {
    font-size: 0.9rem;
    color: var(--color-text-dim);
  }

  .dev__project-highlights li::marker {
    color: var(--color-accent);
  }

  .dev__tags {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dev__tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-dim);
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
  }

  .dev__project-links {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.9rem;
  }

  .dev__project-links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .dev__project-links a:hover {
    text-decoration: underline;
  }

  .dev__project-note {
    color: var(--color-text-dim);
    font-size: 0.85rem;
  }

  /* Contact + footer ------------------------------------------------------ */

  .dev__contact-lead {
    max-width: 38rem;
    color: var(--color-text-dim);
  }

  .dev__contact-links {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dev__footer {
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }
</style>
