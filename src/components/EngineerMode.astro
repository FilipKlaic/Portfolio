---
import { getImage } from "astro:assets";
import DeskSketch from "./sketches/DeskSketch.astro";
import LetterSketch from "./sketches/LetterSketch.astro";

interface Project {
  nickname: string;
  fullName: string;
  slug: string;
  description: string;
  highlights: string[];
  stack: string[];
  href?: string;
  repoUrl?: string;
  repoPrivate?: boolean;
  status?: "live" | "private" | "ongoing";
}

const projects: Project[] = [
  {
    nickname: "wagons",
    fullName: "Fogarolli — Wagon Inventory",
    slug: "wagons",
    description:
      "Inventory tracking tool used on iPads during live catering events, built for the company I work at.",
    highlights: [
      "Real-time inventory counts across catering wagons, synced through Supabase",
      "Swedish-language UI built for on-the-ground staff working at speed during service",
      "In daily production use by my team at events",
    ],
    stack: ["TypeScript", "React", "Vite", "Supabase", "Vercel"],
    repoPrivate: true,
    status: "private",
  },
  {
    nickname: "shifts",
    fullName: "Fogarolli Schedule",
    slug: "shifts",
    description:
      "Companion shift-scheduling PWA for the same business, sharing one Supabase backend with the inventory app.",
    highlights: [
      "Installable on employees' phones as a progressive web app",
      "Admins create shifts; staff mark availability and acknowledge assignments",
      "Role-based access enforced with Supabase auth and row-level security policies",
    ],
    stack: ["TypeScript", "React", "Vite", "Supabase", "PWA"],
    repoPrivate: true,
    status: "private",
  },
  {
    nickname: "savings",
    fullName: "Savings Tracker",
    slug: "savings",
    description:
      "Cross-platform desktop app for tracking income and expenses, auto-allocating a share of income toward savings goals.",
    highlights: [
      "Rust and Tauri backend with local SQLite storage, schema applied via migrations on first launch",
      "Dashboard with a monthly breakdown donut chart and a savings-rate trend line",
      "Feature-sliced architecture so new features can be added without touching existing ones",
    ],
    stack: ["Rust", "Tauri", "TypeScript", "React", "SQLite"],
    repoUrl: "https://github.com/FilipKlaic/Savings-tracker",
    status: "ongoing",
  },
  {
    nickname: "meridian",
    fullName: "Meridian",
    slug: "meridian",
    description:
      "Desktop tool that visualizes a TypeScript project's architecture by mapping file imports and function call chains.",
    highlights: [
      "Rust backend using tree-sitter to parse imports, re-exports, requires, and TypeScript path aliases",
      "Interactive import and call graphs built with React Flow, color-coded by directory with a focus mode to isolate related code",
      "Scan results cached in SQLite so reopening a project is fast, with freshness tracked against file modification times",
    ],
    stack: ["Rust", "Tauri", "React", "TypeScript", "tree-sitter", "SQLite"],
    repoUrl: "https://github.com/FilipKlaic/Meridian",
    status: "ongoing",
  },
  {
    nickname: "atrium",
    fullName: "Atrium",
    slug: "atrium",
    description:
      "Cross-platform chat app built as a Slack/Discord alternative, with a native desktop client and a real-time backend.",
    highlights: [
      "Tauri desktop client for macOS and Windows with servers, channels, and role-based membership",
      "Real-time messaging over WebSockets with presence, typing indicators, and cursor-based pagination",
      "Fastify and PostgreSQL backend with Drizzle ORM, JWT auth using Argon2 hashing and rotating refresh tokens",
    ],
    stack: ["Rust", "Tauri", "React", "TypeScript", "Fastify", "PostgreSQL", "Drizzle"],
    repoUrl: "https://github.com/FilipKlaic/Atrium",
    status: "ongoing",
  },
  {
    nickname: "kova",
    fullName: "Kova",
    slug: "kova",
    description:
      "Site for Kova, my design and engineering consultancy, with a warm editorial design and hand-drawn illustrations.",
    highlights: [
      "Hand-drawn SVG illustrations that share one sketch filter for a consistent ink feel",
      "Small design system: paper palette, serif headlines and a single accent colour",
      "Project details in native dialogs, with no animation libraries",
    ],
    stack: ["Next.js", "TypeScript", "Tailwind CSS", "SVG"],
    href: "https://kova-studio-bice.vercel.app/",
    repoUrl: "https://github.com/FilipKlaic/Kova-Studio",
    status: "live",
  },
  {
    nickname: "nocture",
    fullName: "Nocture",
    slug: "nocture",
    description:
      "A fully themed Hyprland desktop on Arch Linux, with a colour pipeline that regenerates the whole system theme from the current wallpaper.",
    highlights: [
      "Wallpaper changes trigger a Material You palette extraction that updates the bar, terminal, notifications, GTK apps, and launcher simultaneously",
      "Custom window animation curves and a hand-built GTK3 theme",
      "Shell scripting and config management across a dozen interlocking tools",
    ],
    stack: ["Linux", "Lua", "Shell", "GTK", "CSS"],
    repoUrl: "https://github.com/FilipKlaic/Nocture",
    status: "ongoing",
  },
];

// Drop a screenshot in src/assets/screenshots named after a project's `slug`
// (e.g. meridian.png) and it's picked up automatically — no code change needed.
// For multiple screenshots on one project, add a numbered suffix: meridian-2.png,
// meridian-3.png, etc. — they're sorted numerically after the unsuffixed one.
const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/screenshots/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

function slugFromPath(path: string): string {
  const filename = path.split("/").pop() ?? path;
  return filename.replace(/\.[^.]+$/, "");
}

const screenshotsBySlug = new Map<string, { index: number; src: string }[]>();

for (const [path, mod] of Object.entries(screenshotModules)) {
  const name = slugFromPath(path);
  const project = projects.find(
    (p) => name === p.slug || new RegExp(`^${p.slug}[-_](\\d+)$`).test(name),
  );
  if (!project) continue;

  const suffixMatch = name.match(/[-_](\d+)$/);
  const index = suffixMatch ? Number(suffixMatch[1]) : 0;
  const optimized = await getImage({ src: mod.default, width: 1600 });

  const list = screenshotsBySlug.get(project.slug) ?? [];
  list.push({ index, src: optimized.src });
  screenshotsBySlug.set(project.slug, list);
}

for (const list of screenshotsBySlug.values()) {
  list.sort((a, b) => a.index - b.index);
}

const CONTACT = {
  email: "file.klaic@gmail.com",
  github: "https://github.com/FilipKlaic",
  linkedin: "https://www.linkedin.com/in/filip-klaic-6b2006308/",
};

const STACK_GROUPS = [
  { label: "Languages", items: ["TypeScript", "C#", "JavaScript", "Python", "Java", "SQL"] },
  { label: "Frontend", items: ["React", "Next.js", "Astro", "Vite", "HTML & CSS"] },
  { label: "Backend & data", items: ["ASP.NET Core", "Supabase", "PostgreSQL", "SQLite", "Rust (Tauri)"] },
  { label: "Tools & platforms", items: ["Git & GitHub", "Vercel", "Linux", "Figma"] },
];

const statusLabels: Record<string, string> = {
  live: "Live",
  private: "Private",
  ongoing: "In progress",
};

const projectsForModal = projects.map((project) => ({
  slug: project.slug,
  fullName: project.fullName,
  description: project.description,
  highlights: project.highlights,
  stack: project.stack,
  href: project.href ?? null,
  repoUrl: project.repoUrl ?? null,
  repoPrivate: project.repoPrivate ?? false,
  status: project.status ?? null,
  images: (screenshotsBySlug.get(project.slug) ?? []).map((s) => s.src),
}));

// Escape "<" so a stray "</script>" inside project copy can't break out of this tag.
const projectsForModalJson = JSON.stringify(projectsForModal).replace(/</g, "\\u003c");
---

<section data-panel="engineer" class="dev">
  <div class="container">
    <section class="dev__hero">
      <div class="dev__hero-text">
        <p class="dev__availability">
          <span class="dev__availability-dot" aria-hidden="true"></span>
          Available for junior developer roles
        </p>
        <h1 class="dev__name">Filip Klaic</h1>
        <p class="dev__role">Junior software developer</p>
        <p class="dev__lead">
          I build web and desktop applications that people actually use day to day — from inventory tools running on
          iPads during live events to a cross-platform finance tracker. Currently studying Systemutvecklare .NET and
          looking for my first full-time developer role.
        </p>
        <div class="dev__actions">
          <a href="#work" class="btn">View my work</a>
          <a href={`mailto:${CONTACT.email}`} class="link">Get in touch</a>
        </div>
      </div>
      <div class="dev__hero-art">
        <DeskSketch />
      </div>
    </section>

    <section id="about" class="dev__section dev__split">
      <div>
        <p class="eyebrow">About</p>
        <h2 class="dev__section-title">A bit about <em>me.</em></h2>
      </div>
      <div>
        <div class="dev__about-text">
          <p>
            I got into programming at Ehrensvärdska high school through the Teknik, Info &amp; Media program, where I
            first learned C#, HTML, CSS, and JavaScript. I'm now studying at the college level as a Systemutvecklare
            .NET, and I pick up new languages and frameworks on my own time alongside it.
          </p>
          <p>
            What keeps me building is solving problems for people I actually know. The wagon inventory app started as
            something I made for myself and my coworkers to make our shifts easier, and it grew into two production
            apps the business now depends on.
          </p>
        </div>
        <dl class="dev__facts">
          <div>
            <dt>Location</dt>
            <dd>Sweden</dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd>Systemutvecklare .NET (studying)</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Full-stack web &amp; desktop applications</dd>
          </div>
          <div>
            <dt>Looking for</dt>
            <dd>Junior developer role</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="stack" class="dev__section">
      <p class="eyebrow">Tech stack</p>
      <h2 class="dev__section-title">Tools I <em>work with.</em></h2>
      <div class="dev__stack">
        {
          STACK_GROUPS.map((group) => (
            <div class="dev__card dev__stack-group">
              <h3 class="dev__stack-label">{group.label}</h3>
              <ul class="dev__stack-list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="work" class="dev__section">
      <p class="eyebrow">Selected work</p>
      <h2 class="dev__section-title">Things I've <em>built.</em></h2>
      <ul class="dev__projects">
        {
          projects.map((project) => (
            <li class="dev__card dev__project">
              {project.status && (
                <span class="dev__badge" data-status={project.status}>
                  {statusLabels[project.status]}
                </span>
              )}
              <h3 class="dev__project-title">
                <button type="button" class="dev__project-open" data-slug={project.slug} aria-haspopup="dialog">
                  {project.fullName}
                </button>
              </h3>
              <p class="dev__project-desc">{project.description}</p>
              <p class="dev__project-stack">{project.stack.join(" · ")}</p>
              <div class="dev__project-links">
                <span class="dev__project-more">Read more</span>
                {project.href && (
                  <a href={project.href} target="_blank" rel="noopener noreferrer">
                    Visit site ↗
                  </a>
                )}
                {project.repoUrl && (
                  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                    View code ↗
                  </a>
                )}
                {project.repoPrivate && <span class="dev__project-note">Private repository</span>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <script type="application/json" id="dev-projects-data" set:html={projectsForModalJson} />

    <section id="contact" class="dev__section">
      <div class="dev__card dev__contact">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="dev__section-title">Get in <em>touch.</em></h2>
          <p class="dev__contact-lead">
            I'm looking for a junior developer role and happy to talk about anything I've built here. The fastest way
            to reach me is email.
          </p>
          <div class="dev__actions">
            <a href={`mailto:${CONTACT.email}`} class="btn">{CONTACT.email}</a>
            <a href={CONTACT.github} class="link" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={CONTACT.linkedin} class="link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>
        <div class="dev__contact-art">
          <LetterSketch />
        </div>
      </div>
    </section>

    <footer class="dev__footer">
      <p>&copy; 2026 Filip Klaic</p>
      <p>Built with Astro</p>
    </footer>
  </div>

  <dialog class="dev__modal" id="project-modal" aria-labelledby="dev-modal-title">
    <div class="dev__modal-media">
      <img class="dev__modal-img" alt="" />
      <button type="button" class="dev__modal-nav dev__modal-nav--prev" aria-label="Previous screenshot">&larr;</button>
      <button type="button" class="dev__modal-nav dev__modal-nav--next" aria-label="Next screenshot">&rarr;</button>
      <span class="dev__modal-counter"></span>
    </div>
    <div class="dev__modal-info">
      <div class="dev__modal-head">
        <span class="dev__badge dev__modal-badge" hidden></span>
        <button type="button" class="dev__modal-close">Close</button>
      </div>
      <h3 id="dev-modal-title" class="dev__modal-title"></h3>
      <p class="dev__modal-desc"></p>
      <ul class="dev__modal-highlights"></ul>
      <p class="dev__modal-stack"></p>
      <div class="dev__modal-links"></div>
    </div>
  </dialog>
</section>

<script>
  interface ModalProject {
    slug: string;
    fullName: string;
    description: string;
    highlights: string[];
    stack: string[];
    href: string | null;
    repoUrl: string | null;
    repoPrivate: boolean;
    status: "live" | "private" | "ongoing" | null;
    images: string[];
  }

  const statusLabels: Record<string, string> = {
    live: "Live",
    private: "Private",
    ongoing: "In progress",
  };

  const dataEl = document.getElementById("dev-projects-data");
  const projectsData: ModalProject[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

  const modal = document.querySelector<HTMLDialogElement>("#project-modal");
  const modalMedia = modal?.querySelector<HTMLElement>(".dev__modal-media");
  const modalImg = modal?.querySelector<HTMLImageElement>(".dev__modal-img");
  const modalNavPrev = modal?.querySelector<HTMLButtonElement>(".dev__modal-nav--prev");
  const modalNavNext = modal?.querySelector<HTMLButtonElement>(".dev__modal-nav--next");
  const modalCounter = modal?.querySelector<HTMLElement>(".dev__modal-counter");
  const modalBadge = modal?.querySelector<HTMLElement>(".dev__modal-badge");
  const modalTitle = modal?.querySelector<HTMLElement>(".dev__modal-title");
  const modalDesc = modal?.querySelector<HTMLElement>(".dev__modal-desc");
  const modalHighlights = modal?.querySelector<HTMLElement>(".dev__modal-highlights");
  const modalStack = modal?.querySelector<HTMLElement>(".dev__modal-stack");
  const modalLinks = modal?.querySelector<HTMLElement>(".dev__modal-links");

  let currentProject: ModalProject | null = null;
  let currentImageIndex = 0;

  function renderImage() {
    const images = currentProject?.images ?? [];
    if (modalMedia) modalMedia.hidden = images.length === 0;
    if (modalImg && images.length > 0) {
      modalImg.src = images[currentImageIndex];
      modalImg.alt = currentProject ? `${currentProject.fullName} screenshot ${currentImageIndex + 1}` : "";
    }

    const showNav = images.length > 1;
    if (modalNavPrev) modalNavPrev.hidden = !showNav;
    if (modalNavNext) modalNavNext.hidden = !showNav;
    if (modalCounter) {
      modalCounter.hidden = !showNav;
      modalCounter.textContent = `${currentImageIndex + 1} / ${images.length}`;
    }
  }

  function step(delta: number) {
    const len = currentProject?.images.length ?? 0;
    if (len < 2) return;
    currentImageIndex = (currentImageIndex + delta + len) % len;
    renderImage();
  }

  function externalLink(href: string, label: string) {
    const a = document.createElement("a");
    a.href = href;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.textContent = label;
    return a;
  }

  function openModal(slug: string | undefined) {
    const project = projectsData.find((p) => p.slug === slug);
    if (!project || !modal) return;

    if (modalTitle) modalTitle.textContent = project.fullName;
    if (modalDesc) modalDesc.textContent = project.description;
    if (modalStack) modalStack.textContent = project.stack.join(" · ");

    if (modalBadge) {
      modalBadge.hidden = !project.status;
      if (project.status) {
        modalBadge.textContent = statusLabels[project.status] ?? project.status;
        modalBadge.dataset.status = project.status;
      }
    }

    modalHighlights?.replaceChildren(
      ...project.highlights.map((point) => {
        const li = document.createElement("li");
        li.textContent = point;
        return li;
      }),
    );

    if (modalLinks) {
      const links: HTMLElement[] = [];
      if (project.href) links.push(externalLink(project.href, "Visit site ↗"));
      if (project.repoUrl) links.push(externalLink(project.repoUrl, "View code ↗"));
      if (project.repoPrivate) {
        const span = document.createElement("span");
        span.className = "dev__project-note";
        span.textContent = "Private repository";
        links.push(span);
      }
      links.find((el) => el instanceof HTMLAnchorElement)?.classList.add("btn");
      modalLinks.replaceChildren(...links);
    }

    currentProject = project;
    currentImageIndex = 0;
    renderImage();
    modal.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>(".dev__project-open").forEach((button) => {
    button.addEventListener("click", () => openModal(button.dataset.slug));
  });

  modal?.querySelector(".dev__modal-close")?.addEventListener("click", () => modal.close());
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });
  modal?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") step(-1);
    if (event.key === "ArrowRight") step(1);
  });
  modalNavPrev?.addEventListener("click", () => step(-1));
  modalNavNext?.addEventListener("click", () => step(1));
</script>

<style>
  .dev {
    padding-bottom: var(--space-4);
  }

  .dev__card {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    --sketch-paper: var(--color-bg-raised);
  }

  .dev__section {
    padding-top: clamp(4rem, 9vw, 7rem);
  }

  .dev__section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  /* Hero */

  .dev__hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: var(--space-5);
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
  }

  .dev__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .dev__availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4f7a4a;
    box-shadow: 0 0 0 4px var(--fill-sage);
  }

  .dev__name {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 1.8rem + 5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .dev__role {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    color: var(--color-text-dim);
  }

  .dev__lead {
    margin-top: var(--space-3);
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--color-text-dim);
  }

  .dev__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: var(--space-4);
  }

  .dev__hero-art {
    max-width: 440px;
    justify-self: center;
    width: 100%;
  }

  /* About */

  .dev__split {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-5);
  }

  .dev__about-text {
    display: grid;
    gap: 1.25rem;
    font-size: 1.125rem;
    color: var(--color-text-dim);
    padding-top: 2rem;
  }

  .dev__facts {
    margin: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .dev__facts div {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .dev__facts dt {
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .dev__facts dd {
    margin: 0;
  }

  /* Stack */

  .dev__stack {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: var(--space-4);
  }

  .dev__stack-group {
    padding: 1.75rem;
  }

  .dev__stack-label {
    font-size: 1.375rem;
  }

  .dev__stack-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    color: var(--color-text-dim);
  }

  /* Projects */

  .dev__projects {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .dev__project {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
    transition: border-color 200ms ease;
  }

  .dev__project:hover {
    border-color: var(--color-border-strong);
  }

  .dev__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    background: var(--color-bg-deep);
  }

  .dev__badge[data-status="live"] {
    background: var(--fill-sage);
  }

  .dev__badge[data-status="ongoing"] {
    background: var(--fill-ochre);
  }

  .dev__project-title {
    margin-top: 1rem;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .dev__project-open {
    appearance: none;
    border: none;
    background: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
  }

  /* Stretch the button over the whole card */
  .dev__project-open::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .dev__project-open:focus-visible {
    outline: none;
  }

  .dev__project-open:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .dev__project-desc {
    margin-top: 0.6rem;
    color: var(--color-text-dim);
  }

  .dev__project-stack {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

