  </div>

  <div class="dev__modal" id="project-modal" aria-hidden="true">
    <div class="dev__modal-backdrop" data-close></div>
    <div class="dev__modal-box" role="dialog" aria-modal="true" aria-labelledby="dev-modal-title">
      <button type="button" class="dev__modal-close" data-close aria-label="Close">
        &times;
      </button>
      <div class="dev__modal-info">
        <div class="dev__modal-head">
          <h3 id="dev-modal-title" class="dev__modal-title"></h3>
          <span class="dev__badge dev__modal-badge" hidden></span>
        </div>
        <p class="dev__modal-desc"></p>
        <ul class="dev__modal-highlights"></ul>
        <ul class="dev__modal-tags"></ul>
        <div class="dev__modal-links"></div>
      </div>
      <div class="dev__modal-media">
        <button type="button" class="dev__modal-nav dev__modal-nav--prev" aria-label="Previous screenshot" hidden>
          &larr;
        </button>
        <img class="dev__modal-img" alt="" hidden />
        <p class="dev__modal-placeholder">Screenshot coming soon</p>
        <button type="button" class="dev__modal-nav dev__modal-nav--next" aria-label="Next screenshot" hidden>
          &rarr;
        </button>
        <span class="dev__modal-counter" hidden></span>
      </div>
    </div>
  </div>
</section>

<script>
  const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(".dev__reveal"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (revealTargets.length > 0 && !reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -60px 0px" },
    );

    revealTargets.forEach((el) => {
      // Only arm elements that start below the fold, so nothing visible flickers on load.
      if (el.getBoundingClientRect().top < window.innerHeight * 0.9) return;
      el.classList.add("dev__reveal--armed");
      observer.observe(el);
    });
  }
</script>

<script>
  interface ModalProject {
    slug: string;
    fullName: string;
    description: string;
    highlights: string[];
    stack: string[];
    href: string | null;
    repoUrl: string | null;
    repoPrivate: boolean;
    status: "live" | "private" | "ongoing" | null;
    images: string[];
  }

  const statusLabels: Record<string, string> = {
    live: "Live",
    private: "Private",
    ongoing: "In progress",
  };

  const dataEl = document.getElementById("dev-projects-data");
  const projectsData: ModalProject[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

  const modal = document.getElementById("project-modal");
  const modalTitle = modal?.querySelector<HTMLElement>(".dev__modal-title");
  const modalBadge = modal?.querySelector<HTMLElement>(".dev__modal-badge");
  const modalDesc = modal?.querySelector<HTMLElement>(".dev__modal-desc");
  const modalHighlights = modal?.querySelector<HTMLElement>(".dev__modal-highlights");
  const modalTags = modal?.querySelector<HTMLElement>(".dev__modal-tags");
  const modalLinks = modal?.querySelector<HTMLElement>(".dev__modal-links");
  const modalImg = modal?.querySelector<HTMLImageElement>(".dev__modal-img");
  const modalPlaceholder = modal?.querySelector<HTMLElement>(".dev__modal-placeholder");
  const modalClose = modal?.querySelector<HTMLElement>(".dev__modal-close");
  const modalNavPrev = modal?.querySelector<HTMLButtonElement>(".dev__modal-nav--prev");
  const modalNavNext = modal?.querySelector<HTMLButtonElement>(".dev__modal-nav--next");
  const modalCounter = modal?.querySelector<HTMLElement>(".dev__modal-counter");

  let lastFocused: HTMLElement | null = null;
  let currentProject: ModalProject | null = null;
  let currentImageIndex = 0;

  function renderImage() {
    const images = currentProject?.images ?? [];
    const hasImages = images.length > 0;

    if (modalImg && modalPlaceholder) {
      if (hasImages) {
        modalImg.src = images[currentImageIndex];
        modalImg.alt = currentProject ? `${currentProject.fullName} screenshot ${currentImageIndex + 1}` : "";
        modalImg.hidden = false;
        modalPlaceholder.hidden = true;
      } else {
        modalImg.hidden = true;
        modalImg.removeAttribute("src");
        modalPlaceholder.hidden = false;
      }
    }

    const showNav = images.length > 1;
    if (modalNavPrev) modalNavPrev.hidden = !showNav;
    if (modalNavNext) modalNavNext.hidden = !showNav;
    if (modalCounter) {
      modalCounter.hidden = !showNav;
      modalCounter.textContent = `${currentImageIndex + 1} / ${images.length}`;
    }
  }

  function showPrevImage() {
    const len = currentProject?.images.length ?? 0;
    if (len < 2) return;
    currentImageIndex = (currentImageIndex - 1 + len) % len;
    renderImage();
  }

  function showNextImage() {
    const len = currentProject?.images.length ?? 0;
    if (len < 2) return;
    currentImageIndex = (currentImageIndex + 1) % len;
    renderImage();
  }

  function openModal(slug: string | undefined) {
    if (!slug || !modal) return;
    const project = projectsData.find((p) => p.slug === slug);
    if (!project) return;

    if (modalTitle) modalTitle.textContent = project.fullName;

    if (modalBadge) {
      if (project.status) {
        modalBadge.textContent = statusLabels[project.status] ?? project.status;
        modalBadge.dataset.status = project.status;
        modalBadge.hidden = false;
      } else {
        modalBadge.hidden = true;
      }
    }

    if (modalDesc) modalDesc.textContent = project.description;

    if (modalHighlights) {
      modalHighlights.replaceChildren(
        ...project.highlights.map((point) => {
          const li = document.createElement("li");
          li.textContent = point;
          return li;
        }),
      );
    }

    if (modalTags) {
      modalTags.replaceChildren(
        ...project.stack.map((tech) => {
          const li = document.createElement("li");
          li.textContent = tech;
          return li;
        }),
      );
    }

    if (modalLinks) {
      const links: HTMLElement[] = [];
      if (project.href) {
        const a = document.createElement("a");
        a.href = project.href;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = "Visit site";
        links.push(a);
      }
      if (project.repoUrl) {
        const a = document.createElement("a");
        a.href = project.repoUrl;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = "View code";
        links.push(a);
      }
      if (project.repoPrivate) {
        const span = document.createElement("span");
        span.className = "dev__project-note";
        span.textContent = "Private repository";
        links.push(span);
      }
      modalLinks.replaceChildren(...links);
    }

    currentProject = project;
    currentImageIndex = 0;
    renderImage();

    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("dev__modal-open");
    modalClose?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("dev__modal-open");
    lastFocused?.focus();
  }

  function isInsideLinks(target: EventTarget | null): boolean {
    return target instanceof HTMLElement && target.closest(".dev__project-links") !== null;
  }

  document.querySelectorAll<HTMLElement>("[data-slug]").forEach((card) => {
    card.addEventListener("click", (event) => {
      if (isInsideLinks(event.target)) return;
      openModal(card.dataset.slug);
    });
    card.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      if (isInsideLinks(event.target)) return;
      event.preventDefault();
      openModal(card.dataset.slug);
    });
  });

  modal?.querySelectorAll<HTMLElement>("[data-close]").forEach((el) => {
    el.addEventListener("click", closeModal);
  });

  modalNavPrev?.addEventListener("click", showPrevImage);
  modalNavNext?.addEventListener("click", showNextImage);

  document.addEventListener("keydown", (event) => {
    if (modal?.getAttribute("aria-hidden") !== "false") return;
    if (event.key === "Escape") closeModal();
    if (event.key === "ArrowLeft") showPrevImage();
    if (event.key === "ArrowRight") showNextImage();
  });
</script>

<style>
  .dev {
    position: relative;
    color: var(--color-text);
  }

  .dev__wash {
    position: absolute;
    top: -8rem;
    left: -10%;
    right: -10%;
    height: 42rem;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        42% 50% at 22% 26%,
        color-mix(in srgb, var(--color-accent) 20%, transparent),
        transparent 70%
      ),
      radial-gradient(
        38% 46% at 82% 12%,
        color-mix(in srgb, var(--color-accent-2) 18%, transparent),
        transparent 70%
      );
    filter: blur(28px);
  }

  .dev__container {
    position: relative;
    z-index: 1;
  }

  /* Scroll reveal ---------------------------------------------------------- */

  .dev__reveal--armed {
    opacity: 0;
    transform: translateY(16px);
  }

  .dev__reveal--armed.is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dev__container {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 var(--space-3);
  }

  /* Top bar ------------------------------------------------------------- */

  .dev__topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .dev__topbar-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .dev__brand {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dev__nav {
    display: flex;
    gap: var(--space-3);
  }

  .dev__nav a {
    color: var(--color-text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 150ms ease;
  }

  .dev__nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 34rem) {
    .dev__nav {
      display: none;
    }
  }

  /* Hero ---------------------------------------------------------------- */

  .dev__hero {
    padding: var(--space-6) 0 var(--space-5);
  }

  .dev__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

