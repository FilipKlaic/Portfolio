---
import ModeSwitcher from "./ModeSwitcher.astro";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Stack", href: "#stack" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="#top" class="site-header__name">filip<span>.</span>klaic</a>
    <nav class="site-header__nav" data-panel="engineer" aria-label="Sections">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <ModeSwitcher />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 4.25rem;
  }

  .site-header__name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }

  .site-header__name span {
    color: var(--color-accent);
  }

  .site-header__nav {
    display: flex;
    gap: 2rem;
  }

  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      gap: 1rem;
    }

    .site-header__name {
      font-size: 0.9rem;
    }

    .site-header__nav {
      display: none !important;
    }
  }
</style>
