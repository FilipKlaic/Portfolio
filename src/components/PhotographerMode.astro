---
import { Image } from "astro:assets";

interface EventInfo {
  location: string;
  date: string;
  dateSort: string; // ISO yyyy-mm-dd, used to order event groups newest-first
}

// Every photo currently in src/assets/photos is from this event.
const DEFAULT_EVENT: EventInfo = { location: "Ring Knutstorp", date: "26 Jul 2026", dateSort: "2026-07-26" };

// TODO(filip): once Norra Åsum photos are dropped in, key their filenames (no extension) here,
// e.g. "kart-01": { location: "Norra Åsum", date: "2 Aug 2026", dateSort: "2026-08-02" }.
const LANDSKRONA_MEET: EventInfo = { location: "Landskrona", date: "15–16 Aug 2026", dateSort: "2026-08-16" };

const EVENT_OVERRIDES: Record<string, EventInfo> = {
  "amg-gt-low-angle": LANDSKRONA_MEET,
  "e30-m3-profile": LANDSKRONA_MEET,
  "bmw-badge": LANDSKRONA_MEET,
  "gt3-cockpit": LANDSKRONA_MEET,
  "supra-dusk": LANDSKRONA_MEET,
  "supra-window-detail": LANDSKRONA_MEET,
  "wet-wheel-detail": LANDSKRONA_MEET,
  "rider-portrait": LANDSKRONA_MEET,
};

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

function slugFromPath(path: string): string {
  const filename = path.split("/").pop() ?? path;
  return filename.replace(/\.[^.]+$/, "");
}

function titleFromSlug(slug: string): string {
  return slug.replace(/[-_]+/g, " ");
}

interface Photo {
  image: ImageMetadata;
  caption: string;
  event: EventInfo;
}

const photos: Photo[] = Object.entries(photoModules)
  .map(([path, mod]) => {
    const slug = slugFromPath(path);
    const event = EVENT_OVERRIDES[slug] ?? DEFAULT_EVENT;
    return {
      image: mod.default,
      caption: titleFromSlug(slug),
      event,
    };
  })
  .sort((a, b) => a.caption.localeCompare(b.caption));

interface EventGroup {
  key: string;
  event: EventInfo;
  photos: Photo[];
}

const groups: EventGroup[] = Array.from(
  photos
    .reduce((map, photo) => {
      const key = `${photo.event.location}|${photo.event.date}`;
      const group = map.get(key) ?? { key, event: photo.event, photos: [] };
      group.photos.push(photo);
      map.set(key, group);
      return map;
    }, new Map<string, EventGroup>())
    .values(),
).sort((a, b) => b.event.dateSort.localeCompare(a.event.dateSort));

const heroPhoto = photos.find((p) => p.caption === "apex lean 01") ?? photos[0];
---

<section data-panel="photographer" class="photo">
  <div class="container">
    <section class="photo__intro">
      <div>
        <p class="eyebrow">Photography</p>
        <h1 class="photo__title">Motorsport &amp; <em>trackside</em> photography.</h1>
      </div>
      <div class="photo__about">
        <p>
          I ride myself, but it was photography that got me riding more — chasing friends around the track just to
          bring back shots they'd actually want to post. That turned into something bigger: I want to shoot for the
          people at the track, riders and spectators alike, not just for myself.
        </p>
        <p class="photo__gear">
          <span class="photo__gear-label">Shooting on</span>
          Sony A6700 &middot; 70&ndash;350mm G OSS &amp; Sigma 18&ndash;50mm F2.8 Contemporary
        </p>
      </div>
    </section>

    {
      heroPhoto && (
        <div class="photo__hero">
          <Image src={heroPhoto.image} alt="" width={2000} />
        </div>
      )
    }

    {
      photos.length > 0 ? (
        groups.map((group) => (
          <section class="photo__event">
            <div class="photo__event-head">
              <h2 class="photo__event-name">{group.event.location}</h2>
              <p class="photo__event-meta">
                {group.event.date} &middot; {group.photos.length} photos
              </p>
            </div>
            <ul class="photo__grid">
              {group.photos.map((photo) => (
                <li class="photo__item">
                  <button type="button" class="photo__thumb">
                    <Image
                      src={photo.image}
                      alt={`${photo.caption} — ${photo.event.location}, ${photo.event.date}`}
                      width={1400}
                    />
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="photo__empty">
          Photos coming soon — drop files into <code>src/assets/photos</code>.
        </p>
      )
    }

    <footer class="photo__footer">
      <p>&copy; 2026 Filip Klaic</p>
      <p>Shot on Sony A6700</p>
    </footer>
  </div>

  <dialog class="photo__lightbox" aria-label="Photo viewer">
    <button type="button" class="photo__lightbox-close" data-lightbox-close>Close</button>
    <div class="photo__lightbox-stage">
      <button type="button" class="photo__lightbox-nav" data-lightbox-prev aria-label="Previous photo">&larr;</button>
      <img class="photo__lightbox-img" data-lightbox-img alt="" />
      <button type="button" class="photo__lightbox-nav" data-lightbox-next aria-label="Next photo">&rarr;</button>
    </div>
    <div class="photo__lightbox-meta">
      <p data-lightbox-caption></p>
      <p data-lightbox-counter></p>
    </div>
  </dialog>
</section>

<script>
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo__thumb"));
  const lightbox = document.querySelector<HTMLDialogElement>(".photo__lightbox");
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const lightboxCaption = lightbox?.querySelector<HTMLParagraphElement>("[data-lightbox-caption]");
  const lightboxCounter = lightbox?.querySelector<HTMLParagraphElement>("[data-lightbox-counter]");
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-next]");

  let currentIndex = 0;

  function renderCurrent() {
    const img = thumbs[currentIndex]?.querySelector("img");
    if (!img || !lightboxImg || !lightboxCaption || !lightboxCounter) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightboxCaption.textContent = img.alt;
    lightboxCounter.textContent = `${currentIndex + 1} / ${thumbs.length}`;
  }

  function openAt(index: number) {
    currentIndex = index;
    renderCurrent();
    lightbox?.showModal();
  }

  function step(delta: number) {
    if (thumbs.length === 0) return;
    currentIndex = (currentIndex + delta + thumbs.length) % thumbs.length;
    renderCurrent();
  }

  thumbs.forEach((thumb, index) => {
    thumb.addEventListener("click", () => openAt(index));
  });

  if (thumbs.length <= 1) {
    prevBtn?.setAttribute("hidden", "");
    nextBtn?.setAttribute("hidden", "");
  }

  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));

  lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => lightbox.close());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") step(-1);
    if (event.key === "ArrowRight") step(1);
  });
</script>

<style>
  .photo {
    padding-bottom: var(--space-4);
  }

  /* Intro */

  .photo__intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: end;
    gap: var(--space-5);
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
  }

  .photo__title {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 1.6rem + 3.8vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .photo__about {
    display: grid;
    gap: 1.25rem;
    font-size: 1.075rem;
    color: var(--color-text-dim);
  }

  .photo__gear {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-strong);
    font-size: 0.925rem;
    color: var(--color-text);
  }

  .photo__gear-label {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-dim);
  }

  .photo__hero {
    margin-top: var(--space-5);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .photo__hero :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }

  /* Events */

  .photo__event {
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .photo__event-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .photo__event-name {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.1;
  }

  .photo__event-meta {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  /* Masonry-style columns so every photo keeps its own shape */
  .photo__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 260px;
    column-gap: 1rem;
  }

  .photo__item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .photo__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-deep);
    cursor: zoom-in;
  }

  .photo__thumb :global(img) {
    width: 100%;
    height: auto;
    transition: transform 500ms var(--transition-easing);
  }

  .photo__thumb:hover :global(img) {
    transform: scale(1.02);
  }

  .photo__empty {
    padding: var(--space-5) 0;
    color: var(--color-text-dim);
  }

  .photo__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  /* Lightbox */

  .photo__lightbox {
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem;
    border: none;
    background: transparent;
    color: var(--color-bg);
  }

  .photo__lightbox[open] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .photo__lightbox::backdrop {
    background: rgb(31 29 26 / 0.94);
  }

  .photo__lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    border: none;
    background: none;
    color: var(--color-bg);
    font-size: 0.95rem;
    opacity: 0.8;
    cursor: pointer;
  }

  .photo__lightbox-close:hover {
    opacity: 1;
  }

  .photo__lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 0;
  }

  .photo__lightbox-img {
    max-width: min(1400px, calc(100vw - 9rem));
    max-height: calc(100svh - 9rem);
    object-fit: contain;
    border-radius: 8px;
  }

  .photo__lightbox-nav {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(246 243 236 / 0.25);
    border-radius: 50%;
    background: transparent;
    color: var(--color-bg);
    cursor: pointer;
    transition: background 200ms ease;
  }

  .photo__lightbox-nav:hover {
    background: rgb(246 243 236 / 0.1);
  }

  .photo__lightbox-nav[hidden] {
    display: none;
  }

  .photo__lightbox-meta {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.875rem;
    color: rgb(246 243 236 / 0.7);
    text-transform: capitalize;
  }

  @media (max-width: 900px) {
    .photo__intro {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 640px) {
    .photo__lightbox-stage {
      flex-wrap: wrap;
    }

    .photo__lightbox-img {
      max-width: 100%;
      order: -1;
    }

    .photo__hero :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
