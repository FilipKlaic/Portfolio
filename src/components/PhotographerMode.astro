---
import { Image } from "astro:assets";

interface EventInfo {
  location: string;
  date: string;
}

// Every photo currently in src/assets/photos is from this event.
const DEFAULT_EVENT: EventInfo = { location: "Ring Knutstorp", date: "26 Jul 2026" };

// TODO(filip): once Norra Åsum photos are dropped in, key their filenames (no extension) here,
// e.g. "kart-01": { location: "Norra Åsum", date: "2 Aug 2026" }.
const EVENT_OVERRIDES: Record<string, EventInfo> = {};

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

function slugFromPath(path: string): string {
  const filename = path.split("/").pop() ?? path;
  return filename.replace(/\.[^.]+$/, "");
}

function titleFromSlug(slug: string): string {
  return slug.replace(/[-_]+/g, " ");
}

const photos = Object.entries(photoModules)
  .map(([path, mod]) => {
    const slug = slugFromPath(path);
    const event = EVENT_OVERRIDES[slug] ?? DEFAULT_EVENT;
    return {
      image: mod.default,
      caption: titleFromSlug(slug),
      event,
    };
  })
  .sort((a, b) => a.caption.localeCompare(b.caption));
---

<section data-panel="photographer" class="photographer">
  <header class="photographer__intro">
    <h1 class="photographer__title">Filip Klaič</h1>
    <p class="photographer__subtitle">Photography</p>
    <p class="photographer__about">
      I ride myself, but it was photography that got me riding more — chasing friends around the track just to
      bring back shots they'd actually want to post. That turned into something bigger: I want to shoot for the
      people at the track, riders and spectators alike, not just for myself. I shoot on a Sony A6700 with a
      70&ndash;350mm G OSS, usually chasing the moment a bike tips into an apex or the quiet of the paddock before
      the first session.
    </p>
  </header>

  {
    photos.length > 0 ? (
      <ul class="photographer__grid">
        {photos.map(({ image, caption, event }) => (
          <li class="photographer__item">
            <Image src={image} alt={`${caption} — ${event.location}, ${event.date}`} width={1400} />
            <p class="photographer__caption">
              {caption}
              <span class="photographer__event">
                {event.location}, {event.date}
              </span>
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="photographer__empty">
        Photos coming soon — drop files into <code>src/assets/photos</code>.
      </p>
    )
  }
</section>

<style>
  .photographer {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3) var(--space-5);
  }

  .photographer__intro {
    margin-bottom: var(--space-5);
    font-family: var(--font-serif);
  }

  .photographer__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .photographer__subtitle {
    margin-top: var(--space-1);
    color: var(--color-text-dim);
    font-style: italic;
    font-size: 1.1rem;
  }

  .photographer__about {
    margin-top: var(--space-3);
    max-width: 34rem;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
  }

  .photographer__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .photographer__grid {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .photographer__grid {
      columns: 3;
    }
  }

  .photographer__item {
    break-inside: avoid;
    margin-bottom: var(--space-3);
  }

  .photographer__item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  .photographer__caption {
    margin-top: var(--space-1);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-text-dim);
    text-transform: capitalize;
  }

  .photographer__event {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  .photographer__empty {
    color: var(--color-text-dim);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .photographer__empty code {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--color-accent);
  }
</style>
